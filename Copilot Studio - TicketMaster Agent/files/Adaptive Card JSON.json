{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "backgroundImage": {
    "url": "https://example.com/concert-background.jpg",
    "fillMode": "Cover"
  },
  "body": [
    {
      "type": "TextBlock",
      "text": "🎟️ 티켓 예약 신청",
      "weight": "Bolder",
      "size": "Large",
      "horizontalAlignment": "Center",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "아래 정보를 입력해 주세요 😊",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "Input.Text",
      "id": "name",
      "placeholder": "이름을 입력하세요",
      "label": "👤 이름",
      "isRequired": true,
      "errorMessage": "이름은 필수 입력 항목입니다."
    },
    {
      "type": "Input.Text",
      "id": "phone",
      "placeholder": "000-0000-0000",
      "label": "📞 전화번호",
      "regex": "^[0-9]{3}-[0-9]{4}-[0-9]{4}$",
      "isRequired": true,
      "errorMessage": "전화번호는 000-0000-0000 형식으로 입력하세요."
    },
    {
      "type": "Input.ChoiceSet",
      "id": "category",
      "label": "📌 예약 카테고리",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "카테고리를 선택하세요.",
      "choices": [
        { "title": "🎤 콘서트", "value": "concert" },
        { "title": "🏨 숙박", "value": "hotel" },
        { "title": "🍽️ 식당", "value": "restaurant" },
        { "title": "✨ 기타", "value": "other" }
      ]
    },
    {
      "type": "Input.Date",
      "id": "date",
      "label": "📅 예약 날짜",
      "isRequired": true,
      "errorMessage": "예약 날짜를 선택하세요."
    },
    {
      "type": "Input.Number",
      "id": "guests",
      "label": "👥 참가 인원 수",
      "placeholder": "예: 2",
      "min": 1,
      "max": 10
    },
    {
      "type": "Input.Text",
      "id": "notes",
      "label": "📝 요청사항",
      "placeholder": "특별 요청사항을 입력하세요",
      "isMultiline": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "✅ 예약 신청하기",
      "style": "positive"
    }
  ]
}
